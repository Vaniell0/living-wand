source .venv/bin/activate 2>/dev/null

# C runtime libs for pip packages (torch, numpy, etc.)
_ld=""
for lib in libstdc++.so.6 libz.so.1 libGL.so.1 libxkbcommon.so.0; do
  target=$(readlink -f "$HOME/.nix-profile/lib/$lib" 2>/dev/null)
  [ -n "$target" ] && _ld="$(dirname "$target"):$_ld"
done
export LD_LIBRARY_PATH="${_ld}${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH}"
