{
  "_doc": "Engine verb vocabulary for SpellProgram ops (src/wand/actions.py). Verbs are generic game actions, not magic-specific: a cooking or crafting pack reuses the same verbs with its own tag patterns. 'patterns' are regexes matched against algebra tags and the model's semantic tags; each hit adds `weight` to the verb's score. 'channel_defaults' give every element/domain a baseline verb so any spell compiles to something. 'invert' says what a negated channel does instead.",
  "verbs": {
    "damage": {
      "desc": "reduce target health",
      "over_time_status": true
    },
    "heal": {
      "desc": "restore target health"
    },
    "shield": {
      "desc": "absorb incoming damage / spawn barrier"
    },
    "status": {
      "desc": "apply a named status effect (frozen, feared, blinded…)"
    },
    "push": {
      "desc": "knock back / displace away from origin"
    },
    "pull": {
      "desc": "draw toward origin / root in place"
    },
    "move": {
      "desc": "relocate target (teleport, levitate, phase)"
    },
    "timescale": {
      "desc": "change the target's local time rate (factor param)"
    },
    "light": {
      "desc": "emit light, reveal, illuminate"
    },
    "obscure": {
      "desc": "darkness, fog, invisibility — reduce visibility"
    },
    "transform": {
      "desc": "change material / shape / size of target"
    },
    "grow": {
      "desc": "accelerate or spawn living matter"
    },
    "temperature": {
      "desc": "heat (delta > 0) or cool (delta < 0) target or area"
    },
    "cleanse": {
      "desc": "remove dirt, poison or negative statuses"
    },
    "dispel": {
      "desc": "cancel or suppress other spells / magic"
    },
    "reveal": {
      "desc": "information: scry, detect, foresee, diagnose"
    },
    "communicate": {
      "desc": "carry a message / signal between minds or places"
    }
  },
